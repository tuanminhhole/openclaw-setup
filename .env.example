# Mẫu biến môi trường của create-openclaw-bot (installer + Setup UI). Biến đều TÙY CHỌN, có mặc định trong mã.
# Copy thành .env (đã gitignore) hoặc đặt trong unit systemd / docker compose. KHÔNG điền bí mật thật vào tệp này.
# Repo này đọc biến OPENCLAW_*; chưa có biến nào thuộc bảng chuẩn BI-MAT.md mục 2, nên không có chú thích "chuẩn:".

# Bật chế độ wizard Setup UI khi chạy CLI ("true" để ép bật). Ai cấp: tự đặt khi chạy.
OPENCLAW_SETUP_WIZARD=
# URL gốc dịch vụ MonkeyTech Connect cho bước nối Facebook/Instagram. Để trống thì dùng URL mặc định trong mã (META_CONNECT_URL).
OPENCLAW_SETUP_CONNECT_URL=
# Danh sách URL Chrome DevTools Protocol, ngăn cách dấu phẩy. Dùng để điều khiển Chrome gỡ lỗi. Để trống thì dùng mặc định trong mã.
OPENCLAW_BROWSER_CDP_URLS=
# Thư mục profile Chrome gỡ lỗi. Để trống thì mã tự chọn thư mục mặc định.
OPENCLAW_CHROME_PROFILE_DIR=
# Đặt 1 để chép profile Chrome mẫu vào profile gỡ lỗi lần đầu.
OPENCLAW_CHROME_SEED_PROFILE=
# Thư mục dự án bot (nơi có cấu hình OpenClaw). Dùng khi Setup UI cần tìm dự án.
OPENCLAW_PROJECT_DIR=
# Thư mục .openclaw (HOME của OpenClaw). Mặc định ~/.openclaw.
OPENCLAW_HOME=
# Thư mục trạng thái OpenClaw (credentials, session). Mặc định theo OPENCLAW_HOME.
OPENCLAW_STATE_DIR=
# Cổng gateway OpenClaw dùng cho kiểm tra sức khoẻ. Mặc định 18789.
OPENCLAW_GATEWAY_PORT=
# Cổng OpenClaw dự phòng khi không đặt OPENCLAW_GATEWAY_PORT. Mặc định 18789.
OPENCLAW_PORT=
# Đường dẫn CSDL sqlite của 9router trong container (script sinh ra trong docker-gen.js). Mặc định /root/.9router/db/data.sqlite.
NINEROUTER_DB_PATH=
# Cổng web của 9router trong container. Mặc định 20128. (PORT là tên trơn, chuẩn: PORT, giữ.)
PORT=

# --- Biến do hệ điều hành / systemd đặt, mã chỉ ĐỌC để nhận biết môi trường. Thường không cần khai, để dạng comment. ---
# Địa chỉ D-Bus phiên người dùng (Linux), mã tự dò nếu thiếu.
# DBUS_SESSION_BUS_ADDRESS=
# Có màn hình Wayland hay không (Linux), dùng để quyết định mở Chrome có giao diện.
# WAYLAND_DISPLAY=
# Người dùng gốc khi chạy bằng sudo, mã dùng để tìm thư mục home thật.
# SUDO_USER=
# Thư mục nvm của người dùng, mã dùng để tìm Node đã cài qua nvm.
# NVM_DIR=
# systemd đặt khi chạy dưới service, mã dùng để biết đang chạy nền.
# INVOCATION_ID=
# systemd đặt khi chạy dưới service (cùng mục đích INVOCATION_ID).
# JOURNAL_STREAM=
