{
  "name": "create-openclaw-bot",
  "version": "5.21.0",
  "description": "Interactive CLI installer for OpenClaw Bot",
  "main": "dist/cli.js",
  "bin": {
    "create-openclaw-bot": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node docs_dev/tests/build.mjs --deploy",
    "dev": "node docs_dev/tests/build.mjs --deploy --watch",
    "dev:ui": "vite --config src/ui/vite.config.ts",
    "start": "node dist/cli.js",
    "test": "node docs_dev/tests/smoke-cli-logic.mjs && node docs_dev/tests/test-generation.mjs && node docs_dev/tests/test-matrix.mjs && node docs_dev/tests/test-zalo-connect.mjs && node docs_dev/tests/test-fb-messenger.mjs && node docs_dev/tests/test-local-server.mjs",
    "bump": "node docs_dev/tests/bump-version.mjs",
    "release": "node docs_dev/scripts/update.mjs"
  },
  "keywords": [
    "openclaw",
    "cli",
    "bot",
    "zalo",
    "telegram",
    "ai"
  ],
  "author": "tuanminhhole",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^4.3.1",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0"
  },
  "bundleDependencies": [
    "@inquirer/prompts",
    "chalk",
    "fs-extra"
  ],
  "type": "module",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.16"
  }
}
